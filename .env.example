# ==============================================================================
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会进仓库
# ==============================================================================

# ---------- 应用 ----------
APP_NAME=auto-test-platform
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# ---------- 数据库 ----------
# SQLite（默认，开箱即用）：sqlite:///./data/auto_test_platform.db
SQLITE_PATH=./data/auto_test_platform.db
# 切换 MySQL 时把 DB_TYPE 改为 mysql，并配置下面四项
DB_TYPE=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_DATABASE=auto_test_platform

# ---------- 认证 ----------
# 生产环境务必替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<your-jwt-secret-change-me>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 默认管理员（首次启动自动创建） ----------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ---------- DeepSeek（AI 能力） ----------
# 申请入口：https://platform.deepseek.com  ->  API Keys
# 不填也能跑：AI 模块会自动降级为 Mock 模式，其余功能不受影响
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认使用 DeepSeek-V4；若账号暂无 v4 权限，改成 deepseek-chat 即可（接口完全兼容）
DEEPSEEK_MODEL=deepseek-v4
AI_ENABLED=true
AI_MOCK=false
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_TOKENS=4096
# 单次失败分析送入模型的最大日志字符数（成本控制）
AI_MAX_LOG_CHARS=6000

# ---------- 执行引擎 ----------
PYTEST_TIMEOUT_SECONDS=300
PYTEST_MAX_WORKERS=1
DEFAULT_RETRY_TIMES=2
# 同时执行的任务数上限（任务级并发，每个任务一个独立 pytest 子进程）
MAX_CONCURRENT_TASKS=4
# 是否自动生成 Allure HTML 报告（需要本机具备 java + allure CLI）
ALLURE_AUTO_GENERATE=true
ALLURE_COMMAND=allure

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./reports/logs
LOG_RETENTION_DAYS=14
