# ==============================================================================

node_modules
dist
.vite
.pnpm-store

# 本地配置与密钥
.env.local
.env.*.local
*.local

# 版本控制 / IDE
.git
.gitignore
.idea
.vscode
Dockerfile
.dockerignore

*.log
