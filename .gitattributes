# 统一换行符：仓库内一律使用 LF，避免 Windows 开发 + Linux 容器构建时出现整文件 diff
* text=auto eol=lf

# 明确按文本处理的文件类型
*.py      text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.conf    text eol=lf
Dockerfile* text eol=lf

# 二进制文件不做换行转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.db      binary
*.woff    binary
*.woff2   binary

# 锁文件在 GitHub 上折叠显示，避免污染 diff
web/pnpm-lock.yaml linguist-generated=true
